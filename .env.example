# ObVault configuration (copy to .env and edit as needed)

# Port the server listens on
PORT=3000

# --- Real Oberlin sign-in (recommended for actual use) ---
# 1. Go to https://console.cloud.google.com/ and create a project
# 2. Configure the OAuth consent screen (choose "External" or your school Workspace)
# 3. Create an OAuth Client ID of type "Web application"
# 4. Add your origin(s), e.g. http://localhost:3000
# 5. Under "Advanced" you can restrict the app to the oberlin.edu hosted domain
# 6. Paste the client ID below. Demo sign-in automatically turns off.
GOOGLE_CLIENT_ID=

# Demo mode: sample accounts you can pick from the sign-in screen.
# It only runs when GOOGLE_CLIENT_ID is unset, and is meant for local previews.
DEMO_MODE=on

# --- Production / hosting ---
# NODE_ENV=production turns demo mode OFF (required for launch: only real
# @oberlin.edu accounts get in). Set this on your host, not just locally.
# NODE_ENV=production

# Where the JSON store and uploads live. Point this at your host's persistent
# volume (e.g. STORAGE_DIR=/storage). Defaults to the project folder.
# STORAGE_DIR=/storage
